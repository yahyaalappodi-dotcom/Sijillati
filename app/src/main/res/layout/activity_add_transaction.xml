<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="العنوان:" android:gravity="end"/>
        <EditText android:id="@+id/etTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="مثال: راتب، فاتورة، سلفة أحمد..." android:gravity="end"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="المبلغ:" android:gravity="end" android:layout_marginTop="16dp"/>
        <EditText android:id="@+id/etAmount" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="المبلغ" android:inputType="numberDecimal" android:gravity="end"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="العملة:" android:gravity="end" android:layout_marginTop="16dp"/>
        <Spinner android:id="@+id/spinnerCurrency" android:layout_width="match_parent" android:layout_height="wrap_content"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="نوع المعاملة:" android:gravity="end" android:layout_marginTop="16dp"/>
        <RadioGroup android:id="@+id/rgType" android:layout_width="match_parent" android:layout_height="wrap_content">
            <RadioButton android:id="@+id/rbIncome" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="دخل" android:textAlignment="viewEnd"/>
            <RadioButton android:id="@+id/rbExpense" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مصروف" android:textAlignment="viewEnd"/>
            <RadioButton android:id="@+id/rbLent" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="إقراض (أعطيت فلوس لحد)" android:textAlignment="viewEnd"/>
            <RadioButton android:id="@+id/rbBorrowed" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اقتراض (أخذت فلوس من حد)" android:textAlignment="viewEnd"/>
        </RadioGroup>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="طريقة الدفع:" android:gravity="end" android:layout_marginTop="16dp"/>
        <RadioGroup android:id="@+id/rgMethod" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/rbMaster" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ماستر"/>
            <RadioButton android:id="@+id/rbCash" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="كاش"/>
        </RadioGroup>

        <TextView android:id="@+id/tvDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="end" android:layout_marginTop="16dp" android:textStyle="bold"/>
        <Button android:id="@+id/btnDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="اختيار التاريخ" android:layout_marginTop="8dp"/>

        <Button android:id="@+id/btnSave" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="حفظ المعاملة" android:backgroundTint="#1A237E" android:textColor="#FFFFFF" android:layout_marginTop="24dp"/>
    </LinearLayout>
</ScrollView>
